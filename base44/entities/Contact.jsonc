{
  "name": "Contact",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "email"
  ]
}