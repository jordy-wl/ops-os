# ============================================================
# Ops OS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real secrets.
# ============================================================

# ── Clerk Auth ───────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → your app → API Keys
# Required: YES

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/org-setup

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# For local dev: run `supabase start` and use the local URLs printed to terminal
# Required: YES

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# Private (server-only — never expose to browser)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# Local Supabase values (when using `supabase start`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by supabase start>
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<printed by supabase start>

# ── AI — Claude (Anthropic) ──────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
# Required: YES (AI/ML features)
# Used for: reasoning, chat, action routing (claude-sonnet-4-6)

ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── AI — Embeddings (OpenAI) ─────────────────────────────────
# NOTE: Claude API does not provide embeddings. Use OpenAI text-embedding-3-small.
# Get from: https://platform.openai.com → API Keys
# Required: YES (semantic search / pgvector features)
# Used for: embedding events into pgvector (text-embedding-3-small, 1536 dims)

OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Workflow Engine ──────────────────────────────────────────
# Used to secure cron-triggered and internal workflow endpoints.
# Generate random secrets: `openssl rand -hex 32`
# Required: YES (workflow automation)

CRON_SECRET=your-cron-secret-here
WORKFLOW_ENGINE_SECRET=your-workflow-engine-secret-here

# ── App ──────────────────────────────────────────────────────
# Required: NO (defaults shown)

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── E2E Testing (Playwright) ─────────────────────────────────
# Credentials for a Clerk test user — used by Playwright smoke tests.
# Create a test user in your Clerk dashboard and add credentials here.
# Required: NO (tests skip gracefully when not set)

E2E_CLERK_EMAIL=test@example.com
E2E_CLERK_PASSWORD=

# ── Google Integration (Optional) ────────────────────────────
# Used for Google Docs document generation.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Required: NO (Google Docs features only)

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Future / Optional ────────────────────────────────────────
# Uncomment when these integrations are built (Phase 5+)

# Salesforce
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_INSTANCE_URL=

# Xero
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# Resend email
# RESEND_API_KEY=re_XXXX

# Vercel (CI/CD — set in Vercel dashboard, not here)
# VERCEL_TOKEN is set via the Vercel project settings
